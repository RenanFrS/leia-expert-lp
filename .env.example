# Banco de dados Postgres
DATABASE_URI=postgres://usuario:senha@localhost:5432/leia_expert

# Chave usada pelo Payload para assinar sessoes. Gere com: openssl rand -hex 32
PAYLOAD_SECRET=troque_esta_chave

# URL publica do site, sem barra no final
NEXT_PUBLIC_SITE_URL=https://leiaexpert.com.br

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=leia-expert

# Rastreamento. O GTM e o container principal.
# GA4 e Meta Pixel podem ficar vazios se voce preferir disparar tudo pelo GTM.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Verificacao do Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contato
NEXT_PUBLIC_WHATSAPP=5511000000000

# SMTP do aviso de lead novo. Sem SMTP_HOST o site sobe igual, so nao envia email.
# O destinatario e cadastrado no painel, em Configuracoes e Dados da clinica.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=nao-responda@leiaexpert.com.br
